/**
 * @page example_async_highload Пример использования: Высоконагруженная асинхронная запись
 * @brief Сценарий настройки асинхронного логирования с пакетной записью для минимизации задержек в бизнес-логике.
 *
 * @par Архитектурное описание сценария
 * Данный сценарий демонстрирует конфигурацию диспетчера @c stc::logger::Logger 
 * через внедрение зависимостей (Dependency Injection) для работы в режимах 
 * экстремальной нагрузки, где синхронный ввод-вывод становится узким местом (bottleneck). 
 * 
 * Используется асинхронный приемник @c stc::logger::AsyncFileSink, реализующий 
 * паттерн "Producer-Consumer". Вызывающий поток (Producer) лишь помещает сообщение 
 * во внутреннюю очередь, что занимает микросекунды. Физическая запись на диск 
 * осуществляется выделенным фоновым потоком (Consumer) пакетами (batching). 
 * Это полностью исключает блокировки бизнес-потоков на операциях файлового ввода-вывода.
 *
 * @par Используемые компоненты
 * - @c stc::logger::JsonFormatter: Сериализует структуру @c stc::logger::LogRecord 
 *   в формат NDJSON. Структурированное логирование критически важно для высоконагруженных 
 *   систем, так как упрощает автоматический парсинг внешними системами (ELK Stack, Splunk).
 * - @c stc::logger::AsyncFileSink: Асинхронный файловый приемник. Ключевыми параметрами 
 *   настройки являются @c max_batch_size (порог размера пакета), @c flush_interval 
 *   (максимальное время ожидания), @c OverflowPolicy (защита от OOM) и @c ErrorCallback.
 *
 * @par Пример реализации
 * @code{.cpp}
 * #include "stc/logger/logger.hpp"
 * #include "stc/logger/sinks/file/async_file_sink.hpp"
 * #include "stc/logger/formatters/json_formatter.hpp"
 * 
 * int main() {
 *     // 1. Инициализация форматтера для структурированного логирования
 *     auto formatter = std::make_shared<stc::logger::JsonFormatter>();
 * 
 *     // 2. Определение политик отказоустойчивости (v3.1.0)
 *     // kDrop предотвращает неограниченный рост памяти (OOM) при всплесках нагрузки.
 *     auto overflow_policy = stc::logger::OverflowPolicy::kDrop;
 *     
 *     // ErrorCallback позволяет маршрутизировать сбои ФС в систему мониторинга 
 *     // (например, Prometheus или syslog) без прерывания бизнес-логики.
 *     auto error_callback = [](std::string_view msg, int ec) {
 *         // Обработка ошибки (например, ENOSPC или EACCES)
 *     };
 * 
 *     // 3. Создание асинхронного приемника с явным указанием параметров
 *     auto async_sink = std::make_shared<stc::logger::AsyncFileSink>(
 *         "app_async.log", 
 *         formatter, 
 *         nullptr,                          // filter (глобальная фильтрация не задана)
 *         nullptr,                          // rotation_policy (ротация не задана)
 *         256 * 1024,                       // max_batch_size: 256 KB
 *         std::chrono::milliseconds(200),   // flush_interval: 200 ms
 *         overflow_policy,
 *         error_callback
 *     );
 * 
 *     // 4. Инстанцирование диспетчера (Dependency Injection, без синглтонов)
 *     auto logger = std::make_shared<stc::logger::Logger>();
 *     logger->AddSink(async_sink);
 * 
 *     // 5. Генерация лог-сообщений в цикле высокой нагрузки
 *     // Вызов Log возвращает управление мгновенно (Hot Path оптимизирован).
 *     for (int i = 0; i < 1000000; ++i) {
 *         logger->Log(stc::logger::LogLevel::kInfo, "Processing request ID: " + std::to_string(i));
 *     }
 * 
 *     // 6. Корректное завершение (Graceful Shutdown)
 *     // Явный вызов Flush гарантирует сброс остатка очереди перед уничтожением объекта.
 *     logger->Flush(); 
 *     
 *     return 0; // Деструктор logger вызовет request_stop() у std::jthread и дождется завершения фонового потока.
 * }
 * @endcode
 *
 * @par Анализ производительности и компромиссов
 * - @b Преимущества: Минимальная задержка (latency) в вызывающем потоке. Пропускная 
 *   способность ограничена только скоростью диска и эффективностью пакетной записи. 
 *   Внедрение @c OverflowPolicy гарантирует отсутствие неограниченного потребления 
 *   памяти (OOM) при дисбалансе скоростей Producer и Consumer.
 * - @b Недостатки: Потенциальная потеря данных при аварийном завершении процесса 
 *   (crash), так как часть логов может находиться в оперативной памяти (в очереди). 
 *   Сообщения, отброшенные политикой @c kDrop, также не будут записаны.
 * - @b Рекомендации: Данный подход идеален для микросервисов и веб-серверов, 
 *   где потеря нескольких последних строк лога при сбое допустима, а задержка 
 *   ответа критична. Для финансовых систем или критичных к данным приложений 
 *   следует использовать синхронные приемники (@ref example_basic_sync) или 
 *   вызывать @c Flush() в строгих контрольных точках бизнес-процесса.
 */