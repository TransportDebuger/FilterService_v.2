# Пути к файлам
CONFIG_PATH=/opt/xmlfilter/config.json
BACKUP_DIR=/opt/xmlfilter/backups
USERS_FILE=/opt/xmlfilter/users.json
CONFIG_SCHEMA_PATH=/opt/xmlfilter/schema.json

# JWT конфигурация
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Параметры целевого сервиса
SERVICE_NAME=xmlfilter
SERVICE_PID_FILE=/var/run/xmlfilter.pid
SERVICE_METRICS_PORT=9090