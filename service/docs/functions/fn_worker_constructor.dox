/**
 * @fn stc::Worker::Worker(
 *     const SourceConfig& config,
 *     std::shared_ptr<stc::logger::ILogger> logger,
 *     std::shared_ptr<FilterListManager> filter_list_manager,
 *     GlobalMetricsDescriptors global_metrics,
 *     SourceMetricsDescriptors source_metrics)
 *
 * @details
 * Конструктор реализует механизм внедрения зависимостей (DI)
 * и инициализацию инфраструктуры для обработки конкретного
 * источника данных.
 *
 * На первом этапе инкрементируется статический счетчик
 * @c instanceCounter_ для генерации уникального тега
 * @c workerTag_. Этот тег жестко внедряется во все
 * последующие записи логов, что критически важно для
 * трассировки событий в условиях высокой конкуренции
 * множества воркеров.
 *
 * Ключевым шагом является инстанцирование полиморфного
 * адаптера файлового хранилища (@ref stc::IFileStorage).
 * В зависимости от протокола, указанного в
 * @ref stc::SourceConfig, создается конкретная
 * реализация. Адаптеру передаются callback-функции
 * для обработки событий и обновления метрик.
 *
 * Завершающим этапом является вызов @c validatePaths(),
 * который проверяет существование и доступность
 * директорий @c incoming, @c processed и @c bad,
 * создавая их при необходимости.
 *
 * @pre Дескрипторы метрик инициализированы и валидны.
 * @post Адаптер хранилища создан, уникальные теги
 *       сгенерированы, файловая структура проверена.
 *
 * @warning Конструктор генерирует исключение
 *          @c std::runtime_error, если протокол
 *          источника не поддерживается, или если
 *          операционная система отказала в создании
 *          необходимых директорий (например, из-за
 *          нехватки прав доступа).
 *
 * @see stc::IFileStorage
 * @see stc::SourceConfig
 * @see stc::Worker::validatePaths
 *
 * @since 3.2.0
 */