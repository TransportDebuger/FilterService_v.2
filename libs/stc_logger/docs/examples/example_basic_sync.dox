/**
 * @page example_basic_sync Пример использования: Базовая синхронная конфигурация
 * @brief Сценарий минимальной настройки синхронного логирования с дублированием вывода в консоль и файл.
 *
 * @par Архитектурное описание сценария
 * Данный сценарий демонстрирует конфигурацию диспетчера @c stc::logger::Logger 
 * через внедрение зависимостей (Dependency Injection) для сценариев, где 
 * критически важна гарантия немедленной доставки сообщений и строгий порядок 
 * их записи. 
 * 
 * Используется синхронная модель ввода-вывода. Вызывающий поток бизнес-логики 
 * блокируется до завершения физической записи во все зарегистрированные приемники. 
 * Это гарантирует, что к моменту возврата управления из метода логирования данные 
 * уже переданы в буферы операционной системы, что упрощает отладку и анализ 
 * последовательности событий при сбоях.
 *
 * @par Используемые компоненты
 * - @c stc::logger::TextFormatter: Сериализует структуру @c stc::logger::LogRecord 
 *   в человекочитаемый текстовый формат.
 * - @c stc::logger::ConsoleSink: Синхронный приемник, осуществляющий вывод в 
 *   стандартный поток (@c stdout/@c stderr).
 * - @c stc::logger::FileSink: Синхронный файловый приемник. В данном сценарии 
 *   стратегия ротации не используется (передается @c nullptr), файл открывается 
 *   в режиме добавления (@c std::ios::app).
 *
 * @par Пример реализации
 * @code{.cpp}
 * #include "stc/logger/logger.hpp"
 * #include "stc/logger/sinks/console/console_sink.hpp"
 * #include "stc/logger/sinks/file/file_sink.hpp"
 * #include "stc/logger/formatters/text_formatter.hpp"
 * 
 * // Пример бизнес-компонента, принимающего логгер через Dependency Injection
 * class ApplicationComponent {
 * public:
 *     explicit ApplicationComponent(std::shared_ptr<stc::logger::ILogger> logger)
 *         : logger_(std::move(logger)) {}
 * 
 *     void DoWork() {
 *         // Явный вызов метода логирования через интерфейс (без глобальных макросов)
 *         if (logger_) {
 *             logger_->Log(stc::logger::LogLevel::kInfo, "Application component started.");
 *         }
 *     }
 * private:
 *     std::shared_ptr<stc::logger::ILogger> logger_;
 * };
 * 
 * int main() {
 *     // 1. Инициализация форматтера
 *     auto formatter = std::make_shared<stc::logger::TextFormatter>();
 * 
 *     // 2. Создание синхронных приемников
 *     auto console_sink = std::make_shared<stc::logger::ConsoleSink>(formatter);
 * 
 *     // Приемник для записи в файл без ротации (rotation_policy = nullptr)
 *     auto file_sink = std::make_shared<stc::logger::FileSink>(
 *         "application.log", 
 *         formatter, 
 *         nullptr, // Локальный фильтр не используется
 *         nullptr  // Политика ротации не используется
 *     );
 * 
 *     // 3. Инстанцирование диспетчера и регистрация приемников (DI, без синглтонов)
 *     auto logger = std::make_shared<stc::logger::Logger>();
 *     logger->AddSink(console_sink);
 *     logger->AddSink(file_sink);
 * 
 *     // 4. Инъекция зависимости в бизнес-компонент
 *     ApplicationComponent component(logger);
 *     component.DoWork();
 * 
 *     // 5. Гарантированная доставка сообщений перед завершением (Defensive Programming)
 *     // Явный вызов Flush гарантирует сброс всех внутренних буферов приемников 
 *     // на диск до начала разрушения объектов и завершения процесса.
 *     logger->Flush();
 * 
 *     return 0; // Деструктор logger корректно закроет файловые дескрипторы.
 * }
 * @endcode
 *
 * @par Анализ производительности и ограничений
 * - @b Гарантии: Строгий порядок доставки (happens-before) и отсутствие риска 
 *   потери данных при аварийном завершении процесса (crash), так как сообщения 
 *   не задерживаются в очередях оперативной памяти.
 * - @b Ограничения: Общая задержка (latency) вызова метода логирования 
 *   аддитивно складывается из задержек ввода-вывода каждого приемника. 
 * - @b Рекомендации: Данная конфигурация не подходит для сценариев с экстремально 
 *   высокой частотой генерации логов в критических секциях кода (hot paths), 
 *   так как операции файлового ввода-вывода и вывода в консоль будут напрямую 
 *   влиять на время отклика бизнес-логики. Для высоконагруженных систем 
 *   рекомендуется использовать асинхронную модель (@ref example_async_highload).
 */