/**
 * @page example_filtering Пример использования: Глобальная и локальная фильтрация
 * @brief Сценарий настройки двухуровневой системы фильтрации лог-сообщений для оптимизации производительности и гибкой маршрутизации.
 *
 * @par Архитектурное описание сценария
 * Данный сценарий демонстрирует использование двух независимых уровней 
 * фильтрации в библиотеке: глобального (на уровне диспетчера @c stc::logger::Logger) 
 * и локального (на уровне конкретного приемника @c stc::logger::ILogSink).
 * 
 * - @b Глобальная фильтрация (@c stc::logger::LevelFilter): Применяется диспетчером 
 *   до передачи сообщения в приемники. Она отсекает нежелательные логи на самом раннем 
 *   этапе, что критически важно для производительности: если сообщение отфильтровано 
 *   глобально, библиотека не тратит ресурсы на его форматирование и копирование 
 *   в очереди приемников (Zero-Allocation на этапе отсечения).
 * - @b Локальная фильтрация (@c stc::logger::SourceFilter): Применяется внутри 
 *   конкретного приемника. Она позволяет маршрутизировать сообщения по дополнительным 
 *   критериям (например, по имени модуля-источника), не влияя на другие приемники.
 *
 * @par Используемые компоненты
 * - @c stc::logger::TextFormatter: Сериализует структуру @c stc::logger::LogRecord 
 *   в человекочитаемый текстовый формат.
 * - @c stc::logger::LevelFilter: Глобальный фильтр, пропускающий только сообщения 
 *   с уровнем важности не ниже заданного порога.
 * - @c stc::logger::SourceFilter: Локальный фильтр, пропускающий только сообщения, 
 *   источник которых совпадает с заданной строкой.
 * - @c stc::logger::ConsoleSink: Синхронный приемник для вывода в консоль 
 *   (использует только глобальный фильтр).
 * - @c stc::logger::FileSink: Синхронный файловый приемник (использует глобальный 
 *   и локальный фильтры).
 *
 * @par Пример реализации
 * @code{.cpp}
 * #include "stc/logger/logger.hpp"
 * #include "stc/logger/sinks/console/console_sink.hpp"
 * #include "stc/logger/sinks/file/file_sink.hpp"
 * #include "stc/logger/formatters/text_formatter.hpp"
 * #include "stc/logger/filters/level_filter.hpp"
 * #include "stc/logger/filters/source_filter.hpp"
 * 
 * int main() {
 *     auto formatter = std::make_shared<stc::logger::TextFormatter>();
 * 
 *     // 1. Создание глобального фильтра
 *     // Пропускает только сообщения уровня WARNING и выше (WARNING, ERROR, CRITICAL).
 *     auto global_level_filter = std::make_shared<stc::logger::LevelFilter>(
 *         stc::logger::LogLevel::kWarning
 *     );
 * 
 *     // 2. Создание локального фильтра для файлового приемника
 *     // В файл будут записываться ТОЛЬКО логи, источник которых совпадает с "Database".
 *     auto local_source_filter = std::make_shared<stc::logger::SourceFilter>("Database");
 * 
 *     // 3. Создание приемников
 *     // Консольный приемник: не имеет локального фильтра.
 *     auto console_sink = std::make_shared<stc::logger::ConsoleSink>(formatter);
 * 
 *     // Файловый приемник: имеет локальный фильтр "Database".
 *     auto file_sink = std::make_shared<stc::logger::FileSink>(
 *         "database_errors.log", 
 *         formatter, 
 *         local_source_filter, // Локальный фильтр
 *         nullptr              // Политика ротации не используется
 *     );
 * 
 *     // 4. Инстанцирование диспетчера и настройка (Dependency Injection, без синглтонов)
 *     auto logger = std::make_shared<stc::logger::Logger>();
 *     logger->SetFilter(global_level_filter); // Установка глобального фильтра
 *     logger->AddSink(console_sink);
 *     logger->AddSink(file_sink);
 * 
 *     // 5. Генерация тестовых лог-сообщений (явный вызов через интерфейс ILogger)
 *     
 *     // Сценарий 1: INFO из "Network"
 *     // -> Отброшен глобальным фильтром (ниже kWarning). 
 *     //    Не попадает ни в консоль, ни в файл. Форматирование не выполняется.
 *     logger->Log(stc::logger::LogLevel::kInfo, "Network request received", "Network");
 * 
 *     // Сценарий 2: WARNING из "Network"
 *     // -> Проходит глобальный фильтр.
 *     // -> Попадает в консоль (нет локального фильтра).
 *     // -> Отброшен локальным фильтром file_sink (источник != "Database").
 *     logger->Log(stc::logger::LogLevel::kWarning, "Network timeout", "Network");
 * 
 *     // Сценарий 3: ERROR из "Database"
 *     // -> Проходит глобальный фильтр.
 *     // -> Попадает в консоль.
 *     // -> Проходит локальный фильтр file_sink (источник == "Database").
 *     logger->Log(stc::logger::LogLevel::kError, "Connection pool exhausted", "Database");
 * 
 *     // 6. Гарантированная доставка сообщений перед завершением (Defensive Programming)
 *     logger->Flush();
 * 
 *     return 0;
 * }
 * @endcode
 *
 * @par Анализ поведения и оптимизация производительности
 * - @b Экономия ресурсов на глобальном уровне: Поскольку @c stc::logger::LevelFilter 
 *   установлен как глобальный, диспетчер отклоняет сообщения низкого приоритета 
 *   до того, как будет вызван дорогостоящий @c stc::logger::TextFormatter. Это исключает 
 *   лишние аллокации строк и операции форматирования.
 * - @b Гибкость маршрутизации: Локальный фильтр @c stc::logger::SourceFilter позволяет 
 *   создать специализированный "тихий" лог-файл для критически важной подсистемы 
 *   (в данном примере — базы данных), не захламляя его логами от других модулей, 
 *   при этом сохраняя полную картину событий в основном консольном выводе.
 * - @b Независимость контекстов: Локальные фильтры не влияют друг на друга. 
 *   Добавление третьего приемника (например, сетевого syslog) со своим локальным 
 *   фильтром не потребует изменения логики существующих @c ConsoleSink и @c FileSink.
 */